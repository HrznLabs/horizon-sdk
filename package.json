{
  "name": "horizon-protocol-sdk",
  "version": "0.3.2",
  "description": "SDK for integrating with Horizon Protocol - decentralized mission coordination on Base",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "import": "./dist/abis/index.mjs",
      "require": "./dist/abis/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepare": "husky || true",
    "prepublishOnly": "yarn clean && yarn type-check && yarn test && yarn build",
    "sync-abis": "node scripts/sync-abis.mjs"
  },
  "keywords": [
    "horizon",
    "protocol",
    "base",
    "blockchain",
    "ethereum",
    "usdc",
    "missions",
    "escrow",
    "web3",
    "sdk"
  ],
  "author": "Horizon Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HrznLabs/horizon-sdk.git"
  },
  "homepage": "https://github.com/HrznLabs/horizon-sdk#readme",
  "bugs": {
    "url": "https://github.com/HrznLabs/horizon-sdk/issues"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "secretlint": "^13.0.7",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "resolutions": {
    "rollup": "4.59.0",
    "postcss": "^8.5.18",
    "ws": "^8.21.0"
  }
}
